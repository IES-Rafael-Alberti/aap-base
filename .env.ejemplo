# Copia este fichero a .env y rellena tus valores (o usa ./configurar.sh).
# NUNCA subas el .env a git: contiene claves. Ya está en .gitignore.

# --- Modelo (obligatorio) ---
AAP_API_KEY=tu_clave_del_modelo
AAP_URL=https://api.qdiv0.com/v1/chat/completions
AAP_MODELO=kyaky/Qwen3.6-35B-A3B-Uncensored-NVFP4

# --- Claves de tus herramientas (si alguna la necesita) ---
# Muchas herramientas de recon no necesitan clave. Si construyes una que sí
# (por ejemplo una que use una API con registro), añade aquí su clave con el
# formato NOMBRE_API_KEY=valor y léela en tu herramienta con os.environ.
# Ejemplos (descoméntalos solo si construyes esa herramienta):
# HUNTER_API_KEY=tu_clave        # hunter.io (correos)
# SHODAN_API_KEY=tu_clave        # shodan.io (servicios expuestos)

# --- Ajuste opcional ---
# Segundos de espera a la respuesta del modelo (por defecto 300). Súbelo si es lento.
AAP_TIMEOUT=600
